import tkinter as tk

def convert():
    try:
        celsius = float(entry.get())
        fahrenheit = (celsius * 9/5) + 32
        label.config(text=f"{fahrenheit:.2f} °F")
    except ValueError:
        label.config(text="Invalid input")

# Create main window
window = tk.Tk()
window.title("Temperature Converter")
window.geometry("400x200")
window.resizable(False, False)

# Add widgets
instruction_label = tk.Label(window, text="Enter temperature in Celsius:", font=("Arial", 11))
instruction_label.pack(pady=10)

entry = tk.Entry(window, font=("Arial", 14), width=10)
entry.pack(pady=5)

button = tk.Button(window, text="Convert", font=("Arial", 10), command=convert)
button.pack(pady=10)

label = tk.Label(window, text="", font=("Arial", 14, "bold"))
label.pack(pady=5)

# Run event loop
window.mainloop()
